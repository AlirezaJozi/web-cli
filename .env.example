# --- عمومی ---
NODE_ENV=development
PORT=4000
# فقط دامنه فرانت‌اند (CORS و کوکی)
FRONTEND_URL=http://localhost:5173

# --- دیتابیس ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clinic_app
DB_PASSWORD=change-me
DB_NAME=clinic8

# --- احراز هویت ---
# یک رشته تصادفی بلند (حداقل ۳۲ کاراکتر)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
COOKIE_NAME=clinic_admin_token

# --- ادمین اولیه (ساخته‌شده توسط seed.js) ---
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=ChangeMe123!

# --- ایمیل (OTP و اطلاع‌رسانی نوبت) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Clinic <no-reply@clinic.local>"
# ایمیل دریافت‌کننده اطلاع‌رسانی نوبت‌ها (اختیاری)
ADMIN_NOTIFY_EMAIL=admin@clinic.local

# --- OTP ---
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- آپلود ---
UPLOAD_MAX_SIZE_MB=3
